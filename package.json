{
  "name": "it-tooools",
  "displayName": "IT Tooools",
  "description": "離線開發工具箱：跨 PHP／Java 相容性標註的 Hash、JSON 美化搜尋統計、JSON 與各語言資料結構互轉、原生 Diff、排班時間計算、密碼檢查產生、檔案資訊，資料不出本機。",
  "version": "0.1.2",
  "publisher": "workjerry",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lazyjerry/it-tools-ext.git"
  },
  "homepage": "https://github.com/lazyjerry/it-tools-ext#readme",
  "bugs": {
    "url": "https://github.com/lazyjerry/it-tools-ext/issues"
  },
  "keywords": [
    "hash",
    "json",
    "diff",
    "converter",
    "password",
    "tools"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "icon": "resources/icon.png",
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "itTools",
          "title": "IT Tooools",
          "icon": "resources/panel-wrenches.svg"
        }
      ]
    },
    "views": {
      "itTools": [
        {
          "type": "webview",
          "id": "itTools.panel",
          "name": "IT Tooools",
          "icon": "resources/panel-wrenches.svg",
          "contextualTitle": "IT Tooools"
        }
      ]
    },
    "commands": [
      {
        "command": "itTools.openPanel",
        "title": "開啟工具面板",
        "category": "IT Tooools",
        "icon": "$(tools)"
      },
      {
        "command": "itTools.run",
        "title": "執行工具…",
        "category": "IT Tooools"
      },
      {
        "command": "itTools.hashSelection",
        "title": "Hash：計算選取文字",
        "category": "IT Tooools"
      },
      {
        "command": "itTools.json.format",
        "title": "JSON：美化",
        "category": "IT Tooools"
      },
      {
        "command": "itTools.json.minify",
        "title": "JSON：壓縮",
        "category": "IT Tooools"
      },
      {
        "command": "itTools.json.stats",
        "title": "JSON：統計",
        "category": "IT Tooools"
      },
      {
        "command": "itTools.json.search",
        "title": "JSON：搜尋",
        "category": "IT Tooools"
      },
      {
        "command": "itTools.convert.jsonTo",
        "title": "轉換：JSON → 程式語言",
        "category": "IT Tooools"
      },
      {
        "command": "itTools.convert.toJson",
        "title": "轉換：PHP／Python／JS → JSON",
        "category": "IT Tooools"
      },
      {
        "command": "itTools.diff.selectLeft",
        "title": "Diff：選取文字設為比較左側",
        "category": "IT Tooools"
      },
      {
        "command": "itTools.diff.compareWithLeft",
        "title": "Diff：與左側比較",
        "category": "IT Tooools"
      },
      {
        "command": "itTools.diff.compareWithClipboard",
        "title": "Diff：選取文字與剪貼簿比較",
        "category": "IT Tooools"
      },
      {
        "command": "itTools.diff.unified",
        "title": "Diff：產生 unified diff 文字",
        "category": "IT Tooools"
      },
      {
        "command": "itTools.timeCalc",
        "title": "時間計算",
        "category": "IT Tooools"
      },
      {
        "command": "itTools.password.check",
        "title": "密碼：檢查",
        "category": "IT Tooools"
      },
      {
        "command": "itTools.password.generate",
        "title": "密碼：產生",
        "category": "IT Tooools"
      },
      {
        "command": "itTools.fileInfo.show",
        "title": "檔案資訊：顯示",
        "category": "IT Tooools"
      },
      {
        "command": "itTools.fileInfo.refresh",
        "title": "檔案資訊：重新整理",
        "category": "IT Tooools",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "itTools.run",
          "when": "editorHasSelection",
          "group": "itTools@1"
        },
        {
          "command": "itTools.diff.selectLeft",
          "when": "editorHasSelection",
          "group": "itTools@2"
        },
        {
          "command": "itTools.diff.compareWithLeft",
          "when": "editorHasSelection && itTools.diffLeftSet",
          "group": "itTools@3"
        }
      ],
      "commandPalette": [
        {
          "command": "itTools.diff.compareWithLeft",
          "when": "itTools.diffLeftSet"
        }
      ]
    },
    "configuration": {
      "title": "IT Tooools",
      "properties": {
        "itTools.inPlaceEdit": {
          "type": "boolean",
          "default": true,
          "description": "就地轉換類工具（JSON 美化、Base64、命名風格等）直接取代選取文字；關閉則改開新編輯器顯示結果。"
        },
        "itTools.json.indent": {
          "type": "string",
          "enum": [
            "2",
            "4",
            "tab"
          ],
          "default": "2",
          "description": "JSON 美化與語言轉換的縮排。"
        },
        "itTools.password.minLength": {
          "type": "integer",
          "default": 8,
          "minimum": 1,
          "description": "密碼最小長度。"
        },
        "itTools.password.requireUppercase": {
          "type": "boolean",
          "default": true,
          "description": "密碼需含大寫英文。"
        },
        "itTools.password.requireLowercase": {
          "type": "boolean",
          "default": true,
          "description": "密碼需含小寫英文。"
        },
        "itTools.password.requireDigit": {
          "type": "boolean",
          "default": true,
          "description": "密碼需含數字。"
        },
        "itTools.password.requireSymbol": {
          "type": "boolean",
          "default": true,
          "description": "密碼需含特殊符號。"
        },
        "itTools.password.symbolSet": {
          "type": "string",
          "default": "!@#$%^&*()-_=+[]{};:,.<>?",
          "description": "視為特殊符號的字元集，產生密碼時也從這裡取符號。"
        },
        "itTools.password.forbidSequential": {
          "type": "boolean",
          "default": true,
          "description": "禁止 3 個以上的連續字元（abc、123、cba）。"
        },
        "itTools.password.forbidRepeated": {
          "type": "boolean",
          "default": true,
          "description": "禁止同一字元連續重複 3 次以上（aaa）。"
        },
        "itTools.password.forbidKeyboard": {
          "type": "boolean",
          "default": true,
          "description": "禁止鍵盤序列（qwerty、asdf 等 4 碼以上）。"
        },
        "itTools.password.forbidCommon": {
          "type": "boolean",
          "default": true,
          "description": "禁止內建常見弱密碼清單中的密碼（離線比對，不連網）。"
        },
        "itTools.password.generateLength": {
          "type": "integer",
          "default": 16,
          "minimum": 4,
          "maximum": 256,
          "description": "產生密碼的長度。"
        },
        "itTools.password.excludeAmbiguous": {
          "type": "boolean",
          "default": false,
          "description": "產生密碼時排除易混淆字元（0 O 1 l I）。"
        },
        "itTools.fileInfo.resolveOwnerName": {
          "type": "boolean",
          "default": true,
          "description": "檔案資訊重新整理時執行一次 `id -un <uid>` 把擁有者 uid 轉成名稱；關閉則只顯示數字。"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "build:extension": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --sourcemap",
    "build:webview": "esbuild src/webview/main.ts --bundle --format=iife --platform=browser --target=es2022 --outfile=media/main.js --sourcemap",
    "build:tests": "tsc -p .",
    "build": "npm run typecheck && npm run build:extension && npm run build:webview",
    "vscode:prepublish": "npm run build",
    "lint": "eslint .",
    "test:unit": "npm run build:tests && mocha --ui tdd --timeout 10000 \"out/test/unit/**/*.test.js\"",
    "test:integration": "node ./out/test/runTest.js",
    "test": "npm run build && npm run test:unit && npm run test:integration",
    "check": "npm run lint && npm run test",
    "verify:php": "npm run build:tests && ./scripts/verify-php.sh",
    "verify:rules": "npm run build:tests && node ./scripts/verify-password-rules.mjs",
    "package:vsix": "npm run check && vsce package --no-dependencies",
    "release": "./scripts/publish.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "glob": "^11.0.0",
    "mocha": "^11.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
